# =============================================================================
# Local development (no GCP) — copy to .env at repo root
# =============================================================================
#
# Minimum for real Gemini local dev:
#   GEMINI_API_KEY=your_key_here
#   QUIZ_RATE_LIMIT_DISABLED=1
#
# Do NOT set for local dev (quizzes go to api/data/quizzes/ on disk):
#   GCS_QUIZZES_BUCKET, GOOGLE_APPLICATION_CREDENTIALS, GCP_*

# Gemini API key — required for POST /quizzes unless FAKE_QUIZ_SPEC=1 below.
GEMINI_API_KEY=your_key_here

# Disable the 5-quizzes-per-day limit while iterating locally.
QUIZ_RATE_LIMIT_DISABLED=1

# =============================================================================
# Optional: local dev without Gemini (offline / CI-style)
# =============================================================================
# Uses a fixed Harry Potter fixture for stages 1–2 and instant generation
# for stages 3–5. See api/test_mode.py.
# FAKE_QUIZ_SPEC=1

# =============================================================================
# Optional: production / advanced — Google Cloud Storage
# =============================================================================
# Durable quiz artifacts (shareable quiz_id URLs across restarts).
# Requires Application Default Credentials — not a Gemini-style API key.
# Local: gcloud auth application-default login, or a service account JSON path.
# GCS_QUIZZES_BUCKET=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/dev-sa-key.json
# GCS_QUIZZES_PREFIX=quizzes
# QUIZZES_OUT_DIR=
# QUIZZES_CACHE_DIR=/tmp/quiz-cache

# =============================================================================
# Optional: logging (Cloud Run uses JSON when K_SERVICE is set)
# =============================================================================
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# =============================================================================
# Optional: quiz creation rate limit (production default: 5 per IP per UTC day)
# =============================================================================
# QUIZ_CREATE_DAILY_LIMIT=5
# QUIZ_RATE_LIMIT_DISABLED=1
