# Gemini API key (required for POST /quizzes unless using fake mode below).
GEMINI_API_KEY=your_key_here

# Local development without Gemini — uses a fixed Harry Potter fixture for stages 1–2
# and instant generation for stages 3–5.
# FAKE_QUIZ_SPEC=1

# Google Cloud Storage — durable quiz artifacts (shareable quiz_id URLs).
# GCS does not use a separate API key; use Application Default Credentials.
# Local dev: point GOOGLE_APPLICATION_CREDENTIALS at a service account JSON key,
# or run: gcloud auth application-default login
# GCS_QUIZZES_BUCKET=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/dev-sa-key.json
# GCS_QUIZZES_PREFIX=quizzes
# QUIZZES_OUT_DIR=
# QUIZZES_CACHE_DIR=/tmp/quiz-cache
