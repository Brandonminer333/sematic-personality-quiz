# Base URL of the FastAPI classifier backend (no trailing slash).
#
# Preferred (server): read in `app/page.jsx` and passed into the quiz — set this
# in Vercel as an Environment Variable (no NEXT_PUBLIC_ prefix needed).
CLOUD_RUN_URI=http://localhost:8080
#
# Optional client fallback (baked into the bundle at build time). Handy if you
# only set a public URL and rely on client-side fetch without the server prop.
# NEXT_PUBLIC_API_URL=http://localhost:8080
